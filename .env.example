# —— Backend (Vercel / serverless) — never commit real keys; use Vercel env or local .env only
# Server-side only (the browser never sees this). NOT VITE_CLAUDE_API_KEY.
CLAUDE_API_KEY=your_anthropic_key_from_console
# Optional. Defaults to claude-sonnet-4-5-20250929. Older models get retired, so
# override this if the API reports the default model as unavailable.
# CLAUDE_MODEL=claude-sonnet-4-5-20250929
# Required for sign-up/sign-in API routes (generate e.g. openssl rand -base64 32)
JWT_SECRET=at_least_32_random_characters_generate_with_openssl

# Postgres — Neon exports these names from the dashboard (pooled vs direct).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_POOLER_HOST.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR_DIRECT_HOST.neon.tech/neondb?sslmode=require
#
# If you use Vercel’s Neon integration, map POSTGRES_PRISMA_URL → DATABASE_URL
# and POSTGRES_URL_NON_POOLING → DATABASE_URL_UNPOOLED in the Vercel env UI.

# Stripe — get keys from https://dashboard.stripe.com/apikeys (test mode first)
# Publishable keys start with pk_test_ / pk_live_  (NOT mk_, price_, or prod_)
# Secret keys start with sk_test_ / sk_live_
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
# Price IDs from Products → each price (must match the VITE_STRIPE_PRICE_* values)
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxx

# Public app URL (no trailing slash) — used in Checkout / Billing Portal / password reset links
# Must be your real site URL so reset emails contain a working link.
APP_URL=https://scanrename.com

# Password reset emails via Resend (https://resend.com) — REQUIRED in production for reset emails.
# 1) Create a Resend account → API Keys → create key
# 2) EMAIL_FROM must be an EMAIL ADDRESS (not a website URL)
#    Testing: ScanRename <onboarding@resend.dev>  (can only send to your Resend account email)
#    Production: verify your domain in Resend, then e.g. ScanRename <noreply@yourdomain.com>
# 3) Add both vars in Vercel, then Redeploy
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=ScanRename <onboarding@resend.dev>

# —— Frontend (Vite) — VITE_* is exposed to the browser
VITE_API_URL=/api
# Price IDs baked into the frontend at build time (must match STRIPE_PRICE_* above)
VITE_STRIPE_PRICE_PRO=price_xxxxxxxxxxxxx
VITE_STRIPE_PRICE_BUSINESS=price_xxxxxxxxxxxxx
# Public site origin for canonical/Open Graph tags (no trailing slash). Defaults to the production URL.
# VITE_APP_URL=https://scanrename.com
# Optional — not required for Checkout (we redirect to session.url from the server)
# VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
